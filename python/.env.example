# Copy to python/.env and adjust.
#
# --- Local LLM backend (vLLM OpenAI-compatible server) ---
# Start it with (2x H100 NVL available; one is plenty for a 14B):
#   conda activate vllm-qwen
#   vllm serve Qwen/Qwen3-14B --port 8000 \
#       --gpu-memory-utilization 0.90 --max-model-len 16384 --reasoning-parser qwen3
OPENAI_API_KEY=local
OPENAI_MODEL=Qwen/Qwen3-14B
OPENAI_BASE_URL=http://localhost:8000/v1
LLM_DISABLE_THINKING=true

# To use the real OpenAI API instead, leave OPENAI_BASE_URL empty and set:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini

# --- Pipeline ---
# Max diagnosis->intake loop-backs before proceeding on a low-confidence path.
MAX_DIAGNOSIS_RETRIES=2
