# Copy to .env in the directory where you start the API or evaluation runner.
# LLM calls require either an API key or an OpenAI-compatible local endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=180
LLM_DISABLE_THINKING=false
MAX_DIAGNOSIS_RETRIES=2

# Example local backend (use a different port from the API):
# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=your-served-model
# Enable only for a backend supporting chat_template_kwargs.enable_thinking:
# LLM_DISABLE_THINKING=true

# Optional helpers, not required by the default pipeline:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# FHIR_SERVER_URL=http://localhost:8080/fhir
