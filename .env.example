# Copy to .env in the directory where you start the API or evaluation runner.
# Select openai (default) or the optional locally authenticated Codex CLI.
LLM_BACKEND=openai
LLM_TIMEOUT_SECONDS=180
MAX_DIAGNOSIS_RETRIES=2

# OpenAI-compatible backend: requires an API key or a local endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_DISABLE_THINKING=false

# Example local backend (use a different port from the API):
# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=your-served-model
# Enable only for a backend supporting chat_template_kwargs.enable_thinking:
# LLM_DISABLE_THINKING=true

# Optional Codex CLI backend: install the CLI separately, then run
# codex login and codex login status with your ChatGPT account.
# No OPENAI_API_KEY is required for this backend; the CLI uses its own login.
# Set CODEX_MODEL to a model available to your signed-in account.
# Choose a model available to your account; the comparison uses gpt-6.1-sol and gpt-6-astra.
# LLM_BACKEND=codex
# CODEX_MODEL=gpt-6.1-sol
# CODEX_REASONING_EFFORT=medium
# CODEX_CLI_PATH=codex
# LLM_TIMEOUT_SECONDS=300

# Optional helpers, not required by the default pipeline:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# FHIR_SERVER_URL=http://localhost:8080/fhir
